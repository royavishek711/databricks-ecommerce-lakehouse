{
  "datasets": [
    {
      "name": "87c37f31",
      "displayName": "fact_transactions_denorm",
      "config": {
        "version": "1.1",
        "source": "ecommerce.gold.fact_transactions_denorm",
        "dimensions": [
          {
            "name": "transaction_date",
            "expr": "transaction_date"
          },
          {
            "name": "category_name",
            "expr": "category_name"
          },
          {
            "name": "brand_name",
            "expr": "brand_name"
          },
          {
            "name": "product_id",
            "expr": "product_id"
          },
          {
            "name": "day_type",
            "expr": "CASE WHEN is_weekend = 1 THEN 'Weekend' ELSE 'Weekday' END"
          },
          {
            "expr": "source.* EXCEPT (transaction_date, category_name, brand_name, product_id)"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "total_sales",
            "expr": "SUM(net_amount)",
            "displayName": "Total Sales",
            "comment": "Total net sales amount"
          }
        ]
      }
    }
  ],
